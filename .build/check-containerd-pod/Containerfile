# .build/check-containerd-pod/Containerfile (generated -- do not edit)

ARG BASE_IMAGE=quay.io/fedora/fedora:43

FROM scratch AS layer-containerd
COPY candy/layer-containerd/ /

FROM ${BASE_IMAGE}

# Bootstrap
RUN --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked \
    printf 'max_parallel_downloads=10\nfastestmirror=True\n' >> /etc/dnf/dnf.conf && \
    dnf install -y --setopt=install_weak_deps=False curl ca-certificates tar gzip && \
    rm -f /etc/yum.repos.d/terra-mesa.repo 2>/dev/null || true && \
    { [ -L /usr/local ] && mkdir -p "$(readlink /usr/local)"; mkdir -p /usr/local/bin; } && \
    ARCH=$(uname -m) && \
    case "$ARCH" in x86_64) ARCH=amd64;; aarch64) ARCH=arm64;; esac && \
    TASK_URL="https://github.com/go-task/task/releases/latest/download/task_linux_${ARCH}.tar.gz" && \
    (curl -fsSL "$TASK_URL" || wget -qO- "$TASK_URL") | tar -xzf - -C /usr/local/bin task

RUN if ! getent passwd 1000 >/dev/null 2>&1; then \
      LOGIN_SHELL=/bin/sh; [ -x /bin/bash ] && LOGIN_SHELL=/bin/bash; \
      if command -v useradd >/dev/null 2>&1; then \
        (getent group 1000 >/dev/null 2>&1 || groupadd -g 1000 user) && \
        useradd -m -u 1000 -g 1000 -s "$LOGIN_SHELL" user; \
      else \
        (getent group 1000 >/dev/null 2>&1 || addgroup -g 1000 user) && \
        adduser -D -h /home/user -u 1000 -G user -s "$LOGIN_SHELL" user; \
      fi; \
    fi

WORKDIR /home/user

# Layer: layer-containerd
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked \
    dnf install -y \
      containerd
RUN mkdir -p /etc/containerd
COPY --chmod=0644 .build/check-containerd-pod/_inline/layer-containerd/d5c909b3068071335d5869afe4aba26e5880d19fd5633c0c130ca5fe53abb1e7 /etc/containerd/config.toml

